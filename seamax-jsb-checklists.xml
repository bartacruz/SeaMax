<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <group>
        <name>STANDARD</name>
        <checklist>
            <title>Preflight Inspection</title>
            <page>
                <item>
                    <name>EXTERIOR</name>
                </item>
                <item>
                    <name>Pitot Cover</name>
                    <value>REMOVED</value>
                    <marker>
                        <x-m>1.94</x-m>
                        <y-m> 2.664</y-m>
                        <z-m> 1.11 </z-m>
                        <scale>3.0000</scale>
                    </marker>
                    <condition>
                        <equals>
                            <property>/sim/model/securing/pitot-cover</property>
                            <value>0</value>
                        </equals>
                    </condition>
                    <binding>
                        <command>property-assign</command>
                        <property>/sim/model/securing/pitot-cover</property>
                        <value>0</value>
                    </binding>
                </item>
                <item>
                    <name>Aileron</name>
                    <value>CHECK</value>
                </item>
                <item>
                    <name>Rudder</name>
                    <value>CHECK</value>
                </item>
                <item>
                    <name>Elevator</name>
                    <value>CHECK</value>
                </item>
                <item>
                    <name>Tire Pressure</name>
                    <value>CHECK</value>
                </item>
            </page>
            <page>
                <item>
                    <name>CABIN</name>
                </item>
                <item>
                    <name>Documents</name>
                    <value>AVAILABLE ON BOARD</value>
                </item>
                <item>
                    <name>Master Switch</name>
                    <value>OFF</value>
                    <marker>
                        <x-m>1.835</x-m>
                        <y-m> 0.032</y-m>
                        <z-m> 1.29 </z-m>
                        <scale>3.0000</scale>
                    </marker>
                    <condition>
                        <equals>
                            <property>/controls/electric/master-switch</property>
                            <value>0</value>
                        </equals>
                    </condition>
                    <binding>
                        <command>property-assign</command>
                        <property>/controls/electric/master-switch</property>
                        <value>0</value>
                    </binding>
                </item>
                <item>
                    <name>Water Rudder</name>
                    <value>UP</value>
                    <marker>
                        <x-m>1.85</x-m>
                        <y-m> 0</y-m>
                        <z-m> 0.5 </z-m>
                        <scale>5.0000</scale>
                    </marker>
                    <condition>
                        <equals>
                            <property>controls/gear/water-rudder</property>
                            <value>0</value>
                        </equals>
                    </condition>
                    <binding>
                        <command>property-assign</command>
                        <property>controls/gear/water-rudder</property>
                        <value>0</value>
                    </binding>
                </item>
                <item>
                    <name>Weight and balance</name>
                    <value>Gross weight below 1200 lb</value>
                    <condition>
                        <less-than-equals>
                            <property>/fdm/jsbsim/inertia/weight-lbs</property>
                            <value>1200</value>
                        </less-than-equals>
                    </condition>
                    <binding>
                        <command>nasal</command>
                        <script>gui.showWeightDialog()</script>
                    </binding>
                </item>
            </page>
        </checklist>
        <checklist>
            <title>Startup</title>
            <page>
                <item>
                    <name>Master Switch</name>
                    <value>ON</value>
                    <marker>
                        <x-m>1.835</x-m>
                        <y-m> 0.032</y-m>
                        <z-m> 1.29 </z-m>
                        <scale>3.0000</scale>
                    </marker>
                    <condition>
                        <equals>
                            <property>/controls/electric/master-switch</property>
                            <value>1</value>
                        </equals>
                    </condition>
                    <binding>
                        <command>property-assign</command>
                        <property>/controls/electric/master-switch</property>
                        <value>1</value>
                    </binding>
                </item>
                <item>
                    <name>Fuel Tanks</name>
                </item>
                <item>
                    <name>Left Fuel Tank</name>
                    <value>OPEN</value>
                    <marker>
                        <x-m> 1.919</x-m>
                        <y-m>-0.457</y-m>
                        <z-m> 1.217</z-m>
                        <scale>3.0000</scale>
                    </marker>
                    <condition>
                        <equals>
                            <property>/controls/fuel/tank[0]/fuel_selector_pos</property>
                            <value>1</value>
                        </equals>
                    </condition>
                    <binding>
                        <command>property-assign</command>
                        <property>/controls/fuel/tank[0]/fuel_selector</property>
                        <value>1</value>
                    </binding>
                </item>
                <item>
                    <name>Right Fuel Tank</name>
                    <value>OPEN</value>
                    <marker>
                        <x-m> 1.919</x-m>
                        <y-m> 0.457</y-m>
                        <z-m> 1.217</z-m>
                        <scale>3.0000</scale>
                    </marker>
                    <condition>
                        <equals>
                            <property>/controls/fuel/tank[1]/fuel_selector_pos</property>
                            <value>1</value>
                        </equals>
                    </condition>
                    <binding>
                        <command>property-assign</command>
                        <property>/controls/fuel/tank[1]/fuel_selector</property>
                        <value>1</value>
                    </binding>
                </item>
                <item>
                    <name>Fuel pump switch</name>
                    <value>ON</value>
                    <marker>
                        <x-m> 1.656</x-m>
                        <y-m> 0</y-m>
                        <z-m> 1.3</z-m>
                        <scale>3.0000</scale>
                    </marker>
                    <condition>
                        <equals>
                            <property>controls/fuel/tank[2]/boost-pump</property>
                            <value>1</value>
                        </equals>
                    </condition>
                    <binding>
                        <command>property-assign</command>
                        <property>controls/fuel/tank[2]/boost-pump</property>
                        <value>1</value>
                    </binding>
                </item>
                <item>
                    <name>Fuel pressure</name>
                    <value>GREATER THAN 2 PSI</value>
                    <marker>
                        <x-m> 1.11 </x-m>
                        <y-m> 0.375 </y-m>
                        <z-m> 0.78 </z-m>
                        <scale>3.0000</scale>
                    </marker>
                </item>
                <item>
                    <name>Magnetos</name>
                    <value>BOTH ON</value>
                    <marker>
                        <x-m>1.835</x-m>
                        <y-m> -0.026</y-m>
                        <z-m> 1.29 </z-m>
                        <scale>3.0000</scale>
                    </marker>
                    <condition>
                        <equals>
                            <property>/controls/engines/engine/magnetos</property>
                            <value>3</value>
                        </equals>
                    </condition>
                    <binding>
                        <command>property-assign</command>
                        <property>/controls/engines/engine/magnetos</property>
                        <value>3</value>
                    </binding>
                </item>
                <item>
                    <name>Propeller Area</name>
                    <value>CLEARED</value>
                </item>
                <item>
                    <name>Starter</name>
                    <value>ENGAGE</value>
                </item>
            </page>
        </checklist>
        <checklist>
            <title>Before Take off</title>
            <page>
                <item>
                    <name>Nav Lights</name>
                    <value>ON</value>
                    <marker>
                        <x-m> 1.696 </x-m>
                        <y-m> 0.004 </y-m>
                        <z-m> 1.3 </z-m>
                        <scale>3.0000</scale>
                    </marker>
                    <condition>
                        <greater-than>
                            <property>systems/electrical/outputs/nav-lights</property>
                            <value>12</value>
                        </greater-than>
                    </condition>
                </item>
                <item>
                    <name>Fuses</name>
                    <value>ALL ON</value>
                    <marker>
                        <x-m> 1.695 </x-m>
                        <y-m> -0.02 </y-m>
                        <z-m> 1.3 </z-m>
                        <scale>6.0000</scale>
                    </marker>
                </item>
                <item>
                    <name>Oil Temperature</name>
                    <value>INSIDE YELLOW-GREEN ARC</value>
                    <marker>
                        <x-m> 1.11 </x-m>
                        <y-m> 0.225 </y-m>
                        <z-m> 0.78 </z-m>
                        <scale>3.0000</scale>
                    </marker>
                    <condition>
                        <and>
                            <greater-than>
                                <property>/engines/engine/oil-temperature-degc</property>
                                <value>49</value>
                            </greater-than>
                            <less-than>
                                <property>/engines/engine/oil-temperature-degc</property>
                                <value>130</value>
                            </less-than>
                        </and>
                    </condition>
                </item>
                <item>
                    <name>Elevator Trim</name>
                    <value>Neutral or as required</value>
                </item>
                <item>
                    <name>Rudder Trim</name>
                    <value>Neutral or as required</value>
                </item>
                <item>
                    <name>Flaps</name>
                    <value>FIRST NOTCH (10 deg)</value>
                    <marker>
                        <x-m> 1.11 </x-m>
                        <y-m>-0.455 </y-m>
                        <z-m> 0.79 </z-m>
                        <scale>3.0000</scale>
                    </marker>
                    <condition>
                        <equals>
                            <property>surface-positions/flap-pos-deg</property>
                            <value>10</value>
                        </equals>
                    </condition>
                </item>
            </page>
        </checklist>
    </group>
</PropertyList>