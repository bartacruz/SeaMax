<?xml version="1.0"?>
<system name="seamax hydrodynamics">
    <property value="1.9736403">hydro/environment/rho-slug_ft3</property>
    <property value="1.1302106e-05">hydro/environment/kinematic-viscosity-ft2_sec</property>    <!-- Sea
    water at 20 degC. -->

    <property value="0.0">hydro/environment/current-from-north-fps</property>
    <property value="0.0">hydro/environment/current-from-east-fps</property>

    <property value="40.0">hydro/environment/waves-from-deg</property>
    <property value="0.0">hydro/environment/wave-amplitude-ft</property>
    <property value="150.0">hydro/environment/wave-length-ft</property>

    <property value="1">hydro/coeffs/active</property>
    <property value="120">hydro/coeffs/buoyancy</property>
    <property value="100">hydro/coeffs/side-factor</property>
    <property value="15">hydro/coeffs/hull-drag</property>

    <channel name="Enable/disable">
        <fcs_function name="hydro/active-norm">
            <description>
                A property that is 0 when no part of the hull is in the water.
                The maximum value is 1.
            </description>
            <function>
                <product>
                    <sum>
                        <property>/fdm/jsbsim/contact/unit[3]/compression-ft</property>
                        <property>/fdm/jsbsim/contact/unit[4]/compression-ft</property>
                        <property>/fdm/jsbsim/contact/unit[5]/compression-ft</property>
                    </sum>
                    <not>
                        <property>ground/solid</property>
                    </not>
                    <property>hydro/coeffs/active</property>
                </product>
            </function>
            <clipto>
                <min>0</min>
                <max>1</max>
            </clipto>
        </fcs_function>

        <fcs_function name="hydro/center-ground-effect-speed-kt">
            <function>
                <product>
                    <property>/fdm/jsbsim/contact/unit[3]/compression-ft</property>
                    <property>/velocities/groundspeed-kt</property>
                </product>
            </function>
        </fcs_function>
        <fcs_function name="hydro/left-ground-effect-speed-kt">
            <function>
                <product>
                    <property>/fdm/jsbsim/contact/unit[4]/compression-ft</property>
                    <property>/velocities/groundspeed-kt</property>
                </product>
            </function>
        </fcs_function>

        <fcs_function name="hydro/right-ground-effect-speed-kt">
            <function>
                <product>
                    <property>/fdm/jsbsim/contact/unit[5]/compression-ft</property>
                    <property>/velocities/groundspeed-kt</property>
                </product>
            </function>
        </fcs_function>

        <fcs_function name="hydro/ground-effect-speed-kt">
            <function>
                <sum>
                    <property>hydro/center-ground-effect-speed-kt</property>
                    <property>hydro/left-ground-effect-speed-kt</property>
                    <property>hydro/right-ground-effect-speed-kt</property>
                </sum>
            </function>
        </fcs_function>

        <switch name="power-regime">
            <default value="0" />
            <test logic="AND" value="1">
                /engines/active-engine/rpm GT 4000
            </test>
            <output>/fdm/jsbsim/hydro/power-regime</output>
        </switch>
        <!-- <fcs_function name="hydro/immersion-ft">
            <function>
                <product>
                    <not>
                        <property>ground/solid</property>
                    </not>
                    <max>
                        <difference>
                            <property>hydro/environment/water-level-ft</property>
                            <property>/position/altitude-ft</property>
                        </difference>
                        <value>0.0</value>
                    </max>
                </product>
            </function>
        </fcs_function> -->
    </channel>
    <channel name="Environment">

        <fcs_function name="hydro/environment/rho-lbs_ft3">
            <function>
                <product>
                    <value>32.174049</value>
                    <property>hydro/environment/rho-slug_ft3</property>
                </product>
            </function>
        </fcs_function>

        <fcs_function name="hydro/environment/gravity-ft_sec2">
            <function>
                <quotient>
                    <property>inertia/weight-lbs</property>
                    <property>inertia/mass-slugs</property>
                </quotient>
            </function>
        </fcs_function>

    </channel>
    <channel name="Implementation Force Z (up)">

        <fcs_function name="hydro/fbz-lbs">
            <function>
                <product>
                    <property>hydro/ground-effect-speed-kt</property>
                    <p>hydro/coeffs/buoyancy</p>
                    <p>hydro/active-norm</p>
                </product>
            </function>
            <output>external_reactions/hydro-Z/magnitude</output>
        </fcs_function>

    </channel>

    <channel name="Hull drag">
        <fcs_function name="hydro/hull-drag-lbsft">
            <function>
                <product>
                    <property>hydro/ground-effect-speed-kt</property>
                    <p>hydro/coeffs/hull-drag</p>
                    <p>hydro/active-norm</p>
                </product>
            </function>
        </fcs_function>
        <summer name="external_reactions/hydro-hull-drag/magnitude">
            <input>hydro/hull-drag-lbsft</input>
        </summer>
    </channel>
</system>