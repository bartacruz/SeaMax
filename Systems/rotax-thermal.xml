<?xml version="1.0"?>

<system name="rotax-thermal">
    <property type="BOOL" value="0">propulsion/engine/has-started</property>
    <description>
        Engine, liquid and gas temperatures fine-tunned to represent a Rotax 912S.
        Outputs some values to /engines/engine/xxx for Flydat use.
        Temperatures in Celsius.
        Heavily influenced by the DA40 engine thermal system.
        Engine heats proportional to MAP. Cools down transfering heat to water and oil.
        Coolant and oil extract heat from the engine with different heat transfer rates.
        Both cools down with air.
        Exaust gas heats proportional to MAP when running. Cools down with ambient air when not.
        Uses a dynamic value for the integrator and the lag_filter to accelerate the initialization
    </description>

    <channel name="Engine Temperature">

        <fcs_function name="systems/thermal/ambient-temp-c">
            <function>
                <product>
                    <difference>
                        <property>atmosphere/T-R</property>
                        <value>491.67</value>
                    </difference>
                    <value>0.55555</value>
                </product>
            </function>
        </fcs_function>

        <fcs_function name="systems/thermal/engine-heating">
            <function>
                <product>
                    <sum>
                        <product>
                            <property>propulsion/engine[0]/map-inhg</property>
                            <value>1.2</value>
                        </product>
                        <value>10</value>
                    </sum>
                    <property>propulsion/engine/set-running</property>
                </product>

            </function>
        </fcs_function>

        <!-- Helps to get the engine at ambient temp faster -->
        <switch name="systems/thermal/engine-air-coeff">
            <default value="0.01" />
            <test logic="AND" value="1">
                propulsion/engine/has-started ne 1
            </test>
        </switch>

        <fcs_function name="systems/thermal/engine-cooling-air">
            <function>
                <product>
                    <difference>
                        <property>systems/thermal/engine-temp</property>
                        <property>systems/thermal/ambient-temp-c</property>
                    </difference>
                    <property>systems/thermal/engine-air-coeff</property>
                    <sum>
                        <product>
                            <property>velocities/vc-kts</property>
                            <value>0.01</value>
                        </product>
                        <value>1.0</value>
                    </sum>
                </product>
            </function>
        </fcs_function>

        <summer name="systems/thermal/engine-delta-t">
            <input>systems/thermal/engine-heating</input>
            <input>-systems/thermal/oil-heating</input>
            <input>-systems/thermal/coolant-heating</input>
            <input>-systems/thermal/engine-cooling-air</input>
        </summer>

        <switch name="systems/thermal/engine-lag">
            <default value="0.05" />
            <test logic="AND" value="5">
                propulsion/engine/has-started ne 1
            </test>
        </switch>

        <integrator name="systems/thermal/engine-temp">
            <input>systems/thermal/engine-delta-t</input>
            <c1>systems/thermal/engine-lag</c1>
            <output>/engines/engine/cht-degc</output>
        </integrator>
    </channel>

    <channel name="Oil Temperture">
        
        <switch name="systems/thermal/oil-air-coeff">
            <default value="0.025" />
            <test logic="AND" value="1">
                propulsion/engine/has-started ne 1
            </test>
        </switch>

        <fcs_function name="systems/thermal/oil-thermostat">
            <function>
                <table>
                    <independentVar lookup="row">systems/thermal/oil-temp</independentVar>
                    <tableData>
                        74.0 0.0
                        82.0 1.0
                    </tableData>
                </table>
            </function>
        </fcs_function>

        <fcs_function name="systems/thermal/oil-cooling-air">
            <function>
                <product>
                    <difference>
                        <property>systems/thermal/oil-temp</property>
                        <property>systems/thermal/ambient-temp-c</property>
                    </difference>
                    <property>systems/thermal/oil-air-coeff</property>
                    <sum>
                        <product>
                            <property>velocities/vc-kts</property>
                            <value>-0.06</value>
                        </product>
                        <value>-1.0</value>
                    </sum>
                    <property>systems/thermal/oil-thermostat</property>
                </product>
            </function>
        </fcs_function>

        <fcs_function name="systems/thermal/oil-heating">
            <function>
                <product>
                    <difference>
                        <property>systems/thermal/engine-temp</property>
                        <property>systems/thermal/oil-temp</property>
                    </difference>
                    <!-- Engine to oil heat transfer -->
                    <value>0.42</value>
                </product>
            </function>
        </fcs_function>

        <summer name="systems/thermal/oil-target">
            <input>systems/thermal/oil-temp</input>
            <input>systems/thermal/oil-heating</input>
            <input>systems/thermal/oil-cooling-air</input>
        </summer>

        <switch name="systems/thermal/oil-lag">
            <default value="0.007" />
            <test logic="AND" value="5">
                propulsion/engine/has-started ne 1
            </test>
        </switch>

        <lag_filter name="systems/thermal/oil-temp">
            <input>systems/thermal/oil-target</input>
            <c1>systems/thermal/oil-lag</c1>
            <output>/engines/engine/oil-temperature-degc</output>
        </lag_filter>
    </channel>

    <channel name="Oil Pressure">

        <!-- 1. Factor de viscosidad según la temperatura del aceite -->
        <!-- Aceite frío = multiplicador alto (genera más presión en las galerías) -->
        <fcs_function name="systems/thermal/oil-viscosity-factor">
            <function>
                <table>
                    <independentVar lookup="row">systems/thermal/oil-temp</independentVar>
                    <tableData>
                         0.0    2.20  <!-- Muy frío, la presión se dispara -->
                        20.0    1.80
                        50.0    1.30
                        80.0    1.00  <!-- Temperatura óptima, factor neutro -->
                       110.0    0.85  <!-- Muy caliente, el aceite se licúa y la presión cae -->
                    </tableData>
                </table>
            </function>
        </fcs_function>

        <!-- 2. Cálculo de la presión base según las RPM del motor y la viscosidad -->
        <fcs_function name="systems/thermal/oil-pressure-bar">
            <function>
                <product>
                    <property>systems/thermal/oil-viscosity-factor</property>
                    <table>
                        <independentVar lookup="row">propulsion/engine[0]/engine-rpm</independentVar>
                        <tableData>
                               0.0    0.00
                             500.0    0.60
                            1400.0    1.50  <!-- Ralentí normal caliente: ~1.5 bar -->
                            3000.0    3.20
                            5000.0    4.20  <!-- Crucero normal caliente: ~4.2 bar -->
                            5800.0    4.80
                        </tableData>
                    </table>
                </product>
            </function>
            <!-- Pressure relief valve works at 7.0 bar-->
            <clipto>
                <min>0.0</min>
                <max>7.0</max>
            </clipto>
        </fcs_function>


        <!-- 4. Opcional: Conversión a PSI por si tus instrumentos o el FDM nativo la necesitan -->
        <fcs_function name="/engines/engine/oil-pressure-psi-2">
            <function>
                <product>
                    <property>systems/thermal/oil-pressure-bar</property>
                    <value>14.5038</value>
                </product>
            </function>
        </fcs_function>

    </channel>

    <channel name="Coolant Temperature">

        <fcs_function name="systems/thermal/coolant-thermostat">
            <function>
                <table>
                    <independentVar lookup="row">systems/thermal/coolant-temp</independentVar>
                    <tableData>
                        80.0 0.0
                        88.0 1.0
                    </tableData>
                </table>
            </function>
        </fcs_function>

        <fcs_function name="systems/thermal/coolant-cooling">
            <function>
                <product>
                    <difference>
                        <property>systems/thermal/coolant-temp</property>
                        <property>systems/thermal/ambient-temp-c</property>
                    </difference>
                    <value>0.035</value>
                    <sum>
                        <product>
                            <property>velocities/vc-kts</property>
                            <value>-0.13</value>
                        </product>
                        <value>-1.0</value>
                    </sum>
                    <property>systems/thermal/coolant-thermostat</property>
                </product>
            </function>
        </fcs_function>

        <fcs_function name="systems/thermal/coolant-heating">
            <function>
                <product>
                    <difference>
                        <property>systems/thermal/engine-temp</property>
                        <property>systems/thermal/coolant-temp</property>
                    </difference>
                    <value>0.85</value>
                </product>
            </function>
        </fcs_function>

        <summer name="systems/thermal/coolant-target">
            <input>systems/thermal/coolant-temp</input>
            <input>systems/thermal/coolant-heating</input>
            <input>systems/thermal/coolant-cooling</input>
        </summer>

        <switch name="systems/thermal/coolant-lag">
            <default value="0.04" />
            <test logic="AND" value="5">
                propulsion/engine/has-started ne 1
            </test>
        </switch>

        <lag_filter name="systems/thermal/coolant-temp">
            <input>systems/thermal/coolant-target</input>
            <c1>systems/thermal/coolant-lag</c1>
            <output>/engines/engine/coolant-temperature-degc</output>
        </lag_filter>
    </channel>

    <channel name="Exhaust Gas Temperature">
        <fcs_function name="systems/thermal/egt-heating">
            <function>
                <sum>
                    <property>systems/thermal/ambient-temp-c</property>
                    <product>
                        <sum>
                            <product>
                                <property>propulsion/engine/map-inhg</property>
                                <value>26.5</value>
                            </product>
                            <value>180.0</value>
                        </sum>
                        <property>propulsion/engine/set-running</property>
                    </product>
                </sum>
            </function>
        </fcs_function>

        <switch name="systems/thermal/egt-target">
            <default value="systems/thermal/ambient-temp-c" />
            <test value="systems/thermal/egt-heating">
                propulsion/engine/set-running eq 1
            </test>
        </switch>

        <lag_filter name="systems/thermal/egt-temp">
            <input>systems/thermal/egt-target</input>
            <c1>0.40</c1>
            <output>/engines/engine/egt-degc</output>
        </lag_filter>

    </channel>

</system>