<?xml version="1.0" encoding="UTF-8"?>
<external_reactions>

    <force name="hull-Z" frame="LOCAL">
        <location unit="M">
            <x> 0.6 </x>
            <y> 0.00 </y>
            <z> 0.3 </z>
        </location>
        <direction>
            <x> 0.0 </x>
            <y> 0.0 </y>
            <z>-1.0 </z>
        </direction>
    </force>
    <moment name="hull-pitch" frame="BODY" unit="LBSFT">
        <direction>
            <x> 0.0 </x>
            <y> 1.0 </y>
            <z> 0.0 </z>
        </direction>
    </moment>

    <!-- 1. RESISTENCIA DEL CASCO (Unificada en BODY y empujando puramente hacia atrás) -->
    <force name="hydro-hull-drag" frame="BODY">
        <location unit="M">
            <!-- Aplicada en el fondo del casco, cerca del escalón (Ajustar según tu CG) -->
            <x> 2.1 </x>
            <y> 0.0 </y>
            <z> 0.3 </z>
        </location>
        <direction>
            <x> -1.0 </x>
            <y> 0.0 </y>
            <z> 0.0 </z>
        </direction>
    </force>

    <!-- 2. FUERZA LATERAL DEL AGUA (Evita que el avión derrape de costado en el agua, frame BODY) -->
    <force name="hydro-Y" frame="BODY">
        <location unit="M">
            <x> 2.2 </x>
            <y> 0.0 </y>
            <z> 0.2 </z>
        </location>
        <direction>
            <x> 0.0 </x>
            <y> 1.0 </y>
            <z> 0.0 </z>
        </direction>
    </force>

    <!-- 3. FLOTABILIDAD Y PLANEO (Empuja perpendicular al casco hacia arriba, frame BODY) -->
    <force name="hydro-Z" frame="BODY">
        <location unit="M">
            <!-- Centrado en el volumen del casco sumergido -->
            <x> 1.7 </x>
            <y> 0.0 </y>
            <z> 0.3 </z>
        </location>
        <direction>
            <x> 0.0 </x>
            <y> 0.0 </y>
            <z>-1.0 </z> <!-- En JSBSim BODY, Z negativo es hacia ARRIBA (dentro del avión) -->
        </direction>
    </force>

    <!-- 4. MOMENTOS PUROS (Controlados por tus canales XML de amortiguamiento) -->
    <moment name="hydro-pitch" frame="BODY" unit="LBSFT">
        <direction>
            <x> 0.0 </x>
            <y> 1.0 </y>
            <z> 0.0 </z>
        </direction>
    </moment>

    <moment name="hydro-roll" frame="BODY" unit="LBSFT">
        <direction>
            <x> 1.0 </x>
            <y> 0.0 </y>
            <z> 0.0 </z>
        </direction>
    </moment>

    <moment name="hydro-yaw" frame="BODY" unit="LBSFT">
        <direction>
            <x> 0.0 </x>
            <y> 0.0 </y>
            <z> 1.0 </z>
        </direction>
    </moment>

    <!-- Amarre / Mooring (Mantenlo en LOCAL si simula un ancla a la Tierra) -->
    <force name="mooring-north" frame="LOCAL">
        <location unit="M">
            <x> 0.0 </x>
            <y> 0.0 </y>
            <z> 0.0 </z>
        </location>
        <direction>
            <x> 1.0 </x>
            <y> 0.0 </y>
            <z> 0.0 </z>
        </direction>
    </force>

    <force name="mooring-east" frame="LOCAL">
        <location unit="">
            <x> 0.0 </x>
            <y> 0.0 </y>
            <z> 0.0 </z>
        </location>
        <direction>
            <x> 0.0 </x>
            <y> 1.0 </y>
            <z> 0.0 </z>
        </direction>
    </force>
    <force name="mooring-down" frame="LOCAL">
        <location unit="">
            <x> 0.0 </x>
            <y> 0.0 </y>
            <z> 1.0 </z>
        </location>
        <direction>
            <x> 1.0 </x>
            <y> 0.0 </y>
            <z> 0.0 </z>
        </direction>
    </force>

</external_reactions>
  