<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <logic>
        <name>Sound boost</name>
        <input>
            <or>
                <property>sim/model/door-positions/canopy/position-norm</property>
                <not>
                    <property>/sim/current-view/internal</property>
                </not>
            </or>
        </input>
        <output>
            <property>/aircraft/sound-boost</property>
        </output>
    </logic>
    <logic>
        <name>water still</name>
        <input>
            <and>
                <greater-than>
                    <property>/sim/multiplay/generic/float[10]</property>
                    <value>0</value>
                </greater-than>
                <less-than>
                    <property>/velocities/groundspeed-kt</property>
                    <value>20</value>
                </less-than>
            </and>
        </input>
        <output>
            <property>/aircraft/water-still</property>
        </output>
    </logic>
    <filter>
        <type>gain</type>
        <gain>0.05</gain>
        <input>/velocities/groundspeed-kt</input>
        <output>/aircraft/roll-volume</output>

    </filter>
    <filter>
        <type>noise-spike</type>
		<max-rate-of-change>3</max-rate-of-change>
        <input>/controls/fuel/tank[0]/fuel_selector</input>
        <output>/controls/fuel/tank[0]/fuel_selector_pos</output>
        
    </filter>
    <filter>
        <type>noise-spike</type>
		<max-rate-of-change>3</max-rate-of-change>
        <input>/controls/fuel/tank[1]/fuel_selector</input>
        <output>/controls/fuel/tank[1]/fuel_selector_pos</output>
    </filter>

</PropertyList>