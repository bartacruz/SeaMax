<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <path>rotax912-oil-temp.ac</path>
    <effect>
        <inherits-from>../../../Effects/Glass/glass</inherits-from>
        <object-name>oil temp glass</object-name>
    </effect>
    <animation>
        <type>material</type>
        <object-name>oil temp</object-name>
        <object-name>oil temp needle</object-name>
        <condition>
            <not>
                <property>sim/rendering/rembrandt/enabled</property>
            </not>
        </condition>
        <emission>
            <red> 0.07 </red>
            <green> 0.04 </green>
            <blue> 0.04 </blue>
            <factor-prop>systems/electrical/outputs/instrument-lights</factor-prop>
        </emission>
    </animation>

    <animation>
		<type>rotate</type>
		<object-name>oil temp needle</object-name>
		<property>/engines/engine/oil-temperature-degf</property>
		<interpolation>
			<entry>
				<ind>   0 </ind>
				<dep>   0 </dep>
			</entry>
			<entry>
				<ind>  120</ind>
				<dep>  38.3</dep>
			</entry>
			<entry>
				<ind>  192 </ind>
				<dep>  60.5 </dep>
			</entry>
			<entry>
				<ind>  230 </ind>
				<dep>  82.4 </dep>
			</entry>
			<entry>
				<ind>  265 </ind>
				<dep> 109.45 </dep>
			</entry>
			<entry>
				<ind>  300 </ind>
				<dep> 124.45 </dep>
			</entry>
			<entry>
				<ind>  800 </ind>
				<dep> 162.0 </dep>
			</entry>
		</interpolation>
		<center>
			<x-m>0.0032</x-m>
			<y-m>0.0137</y-m>
			<z-m>0</z-m>
				
		</center>
		<axis>
			<x> -1 </x>
			<y>  0 </y>
			<z>  0 </z>
		</axis>
	</animation>
</PropertyList>