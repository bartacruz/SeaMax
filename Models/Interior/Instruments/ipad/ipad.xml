<?xml version="1.0"?>

<PropertyList>

    <path>ipad.ac</path>

    <animation>
        <type>pick</type>
        <object-name>homebutton</object-name>
        <action>
            <button>0</button>
            <repeatable>false</repeatable>
            <binding>
                <command>property-assign</command>
                <property>/instrumentation/ipad/homebutton</property>
                <value>1</value>
            </binding>
            <mod-up>
                <binding>
                    <command>property-assign</command>
                    <property>/instrumentation/ipad/homebutton</property>
                    <value>0</value>
                </binding>
            </mod-up>
        </action>
    </animation>

</PropertyList>