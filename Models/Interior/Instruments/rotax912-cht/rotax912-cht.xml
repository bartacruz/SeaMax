<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
    <path>rotax912-cht.ac</path>
    <effect>
        <inherits-from>../../../Effects/Glass/glass</inherits-from>
        <object-name>cht glass</object-name>
    </effect>
    <animation>
        <type>material</type>
        <object-name>cht</object-name>111n
        <object-name>cht needle</object-name>
        <condition>
            <not>
                <property>sim/rendering/rembrandt/enabled</property>
            </not>
        </condition>
        <emission>
            <red> 0.07 </red>
            <green> 0.04 </green>
            <blue> 0.04 </blue>
            <factor-prop>systems/electrical/outputs/instrument-lights</factor-prop>
        </emission>
    </animation>

    <animation>
		<type>rotate</type>
		<object-name>cht needle</object-name>
		<property>/engines/engine/cht-degf</property>
		<interpolation>
			<entry>
				<ind>   0 </ind>
				<dep>   0 </dep>
			</entry>
			<entry>
				<ind>  120</ind>
				<dep>  13 </dep>
			</entry>
			<entry>
				<ind>  210 </ind>
				<dep>   46.5</dep>
			</entry>
			<entry>
				<ind>  250 </ind>
				<dep>  76.7 </dep>
			</entry>
			<entry>
				<ind>  275 </ind>
				<dep> 93.2 </dep>
			</entry>
			<entry>
				<ind>  300 </ind>
				<dep> 104.6</dep>
			</entry>
		</interpolation>
		<center>
			<x-m>0.003206</x-m>
			<y-m>0.012</y-m>
			<z-m>0.00125</z-m>				
		</center>
		<axis>
			<x> -1 </x>
			<y>  0 </y>
			<z>  0 </z>
		</axis>
	</animation>
</PropertyList>