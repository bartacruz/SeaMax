<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>seamax-interior.ac</path>

  <model>
    <path>panel.xml</path>
  </model>

  <!-- Yoke-->
  <animation>
    <type>rotate</type>
    <object-name>yoke</object-name>
    <object-name>yoke cover</object-name>
    <property>controls/flight/elevator</property>
    <interpolation>
      <entry>
        <ind>-1</ind>
        <dep>-33</dep>
      </entry>
      <entry>
        <ind> 0</ind>
        <dep> 0</dep>
      </entry>
      <entry>
        <ind> 1</ind>
        <dep> 33</dep>
      </entry>
    </interpolation>
    <center>
      <x-m> 1.27</x-m>
      <y-m> 0</y-m>
      <z-m> 0.5</z-m>
    </center>
    <axis>
      <x> 0</x>
      <y>-1</y>
      <z> 0</z>
    </axis>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>yoke</object-name>
    <object-name>yoke cover</object-name>
    <property>controls/flight/aileron</property>
    <interpolation>
      <entry>
        <ind>-1</ind>
        <dep>-33</dep>
      </entry>
      <entry>
        <ind> 0</ind>
        <dep> 0</dep>
      </entry>
      <entry>
        <ind> 1</ind>
        <dep> 33</dep>
      </entry>
    </interpolation>
    <center>
      <x-m> 1.27</x-m>
      <y-m> 0</y-m>
      <z-m> 0.5</z-m>
    </center>
    <axis>
      <x>-1</x>
      <y> 0</y>
      <z> 0</z>
    </axis>
  </animation>
  <!-- Flaps indicator -->

  <animation>
    <type>select</type>
    <object-name>flaps.right.5.led</object-name>
    <object-name>flaps.left.5.led</object-name>
    <condition>
      <property>/systems/electrical/outputs/main-bus</property>
      <equals>
        <property>surface-positions/flap-pos-norm</property>
        <value>0</value>
      </equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>flaps.right.10.led</object-name>
    <object-name>flaps.left.10.led</object-name>
    <condition>
      <property>/systems/electrical/outputs/main-bus</property>
      <greater-than-equals>
        <property>surface-positions/flap-pos-norm</property>
        <value>0.375</value>
      </greater-than-equals>
    </condition>
  </animation>
  <animation>
    <type>select</type>
    <object-name>flaps.right.18.led</object-name>
    <object-name>flaps.left.18.led</object-name>
    <condition>
      <property>/systems/electrical/outputs/main-bus</property>
      <greater-than-equals>
        <property>surface-positions/flap-pos-norm</property>
        <value>0.575</value>
      </greater-than-equals>
    </condition>
  </animation>
  <animation>
    <type>select</type>
    <object-name>flaps.right.28.led</object-name>
    <object-name>flaps.left.28.led</object-name>
    <condition>
      <property>/systems/electrical/outputs/main-bus</property>
      <greater-than-equals>
        <property>surface-positions/flap-pos-norm</property>
        <value>0.825</value>
      </greater-than-equals>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>flaps.right.35.led</object-name>
    <object-name>flaps.left.35.led</object-name>
    <condition>
      <property>/systems/electrical/outputs/main-bus</property>
      <greater-than-equals>
        <property>surface-positions/flap-pos-norm</property>
        <value>1</value>
      </greater-than-equals>
    </condition>
  </animation>

  <animation>
    <type>material</type>
    <object-name>flaps.right.5.led</object-name>
    <object-name>flaps.left.5.led</object-name>
    <object-name>flaps.right.10.led</object-name>
    <object-name>flaps.left.10.led</object-name>
    <object-name>flaps.right.18.led</object-name>
    <object-name>flaps.left.18.led</object-name>
    <object-name>flaps.right.28.led</object-name>
    <object-name>flaps.left.28.led</object-name>
    <object-name>flaps.right.35.led</object-name>
    <object-name>flaps.left.35.led</object-name>
    <emission>
      <red> 1 </red>
      <green> 1 </green>
      <blue> 0.2 </blue>
    </emission>
  </animation>

  <animation>
    <type>pick</type>
    <object-name>flaps.left.switch</object-name>
    <object-name>flaps.right.switch</object-name>
    <action>
      <button>0</button>
      <repeatable>false</repeatable>
      <binding>
        <command>nasal</command>
        <script>controls.flapsDown(-1);</script>
      </binding>
    </action>

    <action>
      <button>1</button>
      <repeatable>false</repeatable>
      <binding>
        <command>nasal</command>
        <script>controls.flapsDown(1);</script>
      </binding>
    </action>

		<action>
			<button>3</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>controls.flapsDown(-1);</script>
			</binding>
		</action>

		<action>
			<button>4</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>controls.flapsDown(1);</script>
			</binding>
		</action>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>flaps_switch</tooltip-id>
				<label>left click or scroll-down to lower flaps, right-click or scroll-up to rise them</label>
			</binding>
		</hovered>
  </animation>

